{
  "name": "playtrove-site",
  "version": "0.1.0",
  "private": true,
  "description": "Official Playtrove website, documentation and release news.",
  "license": "MIT",
  "scripts": {
    "dev": "npm run sync:releases && docusaurus start --host 127.0.0.1 --no-open",
    "sync:releases": "node scripts/sync-releases.mjs",
    "build": "npm run sync:releases && npm run typecheck && docusaurus build",
    "build:test": "node scripts/sync-releases.mjs --fixture tests/fixtures/releases.json && npm run typecheck && docusaurus build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:site": "playwright test",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.1.1",
    "@fontsource-variable/geist": "^5.3.0",
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "marked": "18.1.1",
    "sanitize-html": "2.18.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0"
  }
}